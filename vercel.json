{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ats-one-snjxqdnjpayguolhafhh.onrender.com/api/:path*"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/web/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/r12b.js",
      "destination": "/web/r12b.js"
    }
  ],
  "headers": [
    {
      "source": "/web/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
