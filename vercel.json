{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ats-one-r17-green-677fd5b.onrender.com/api/:path*"
    }
  ],
  "headers": [
